msgctxt "Addon Summary"
msgid "Sega - MS/GG/MD/CD/32X (PicoDrive)"
msgstr "世嘉 - MS/GG/MD/CD/32X (PicoDrive)"

msgctxt "Addon Description"
msgid "PicoDrive is yet another Sega Game Gear / Master System / Mega Drive / Mega CD / 32X emulator heavily optimized for ARM."
msgstr "PicoDrive 是另一款针对 ARM 进行了大量优化的 Sega Game Gear / Master System / Mega Drive / Mega CD / 32X 模拟器。"

msgctxt "Addon Disclaimer"
msgid "Authors: Dave (aka fdave, FinalBurn author) and notaz"
msgstr "作者：Dave（又名 fdave，FinalBurn 作者）和 notaz"

msgctxt "#30001"
msgid "System Region"
msgstr "系统区域"

msgctxt "#30002"
msgid "Master System Type"
msgstr "主系统类型"

msgctxt "#30003"
msgid "Master System ROM Mapping"
msgstr "主系统 ROM 映射"

msgctxt "#30004"
msgid "Sega CD RAM Cart"
msgstr "世嘉 CD RAM Cart"

msgctxt "#30005"
msgid "Core-Provided Aspect Ratio"
msgstr "核心提供的纵横比"

msgctxt "#30006"
msgid "LCD Ghosting Filter"
msgstr "LCD 重影滤波器"

msgctxt "#30007"
msgid "Video Renderer"
msgstr "视频渲染器"

msgctxt "#30008"
msgid "Audio Sample Rate (Hz)"
msgstr "音频采样率（Hz）"

msgctxt "#30009"
msgid "FM filtering"
msgstr "调频滤波"

msgctxt "#30010"
msgid "Master System FM Sound Unit"
msgstr "主系统 FM 声音单元"

msgctxt "#30012"
msgid "Audio Filter"
msgstr "音频滤波器"

msgctxt "#30013"
msgid "Low-Pass Filter %"
msgstr "低通滤波器 %"

msgctxt "#30014"
msgid "Input Device 1"
msgstr "输入设备1"

msgctxt "#30015"
msgid "Input Device 2"
msgstr "输入设备2"

msgctxt "#30016"
msgid "Dynamic Recompilers"
msgstr "动态重编译器"

msgctxt "#30017"
msgid "Frameskip"
msgstr "帧跳过"

msgctxt "#30018"
msgid "Frameskip Threshold (%)"
msgstr "帧跳过阈值（%）"

msgctxt "#30019"
msgid "No Sprite Limit"
msgstr "无 Sprite 限制"

msgctxt "#30020"
msgid "68K Overclock"
msgstr "68K 超频"

msgctxt "#30021"
msgid "Master System Palette in TMS modes"
msgstr "TMS 模式下的主系统调色板"

msgctxt "#30022"
msgid "Mega Drive FM chip type"
msgstr "Mega Drive FM 芯片类型"

msgctxt "#30023"
msgid "System"
msgstr ""

msgctxt "#30024"
msgid "Configure region / base hardware selection / ROM mapping / Sega CD RAM cart."
msgstr ""

msgctxt "#30025"
msgid "Specify which region the system is from. 'PAL'/'Europe' is 50hz while 'NTSC'/'US' is 60hz. Games may run faster or slower than normal (or produce errors) if the incorrect region is selected."
msgstr ""

msgctxt "#30026"
msgid "Choose which type of hardware (SMS or Game Gear) the core should emulate when running Master System content."
msgstr ""

msgctxt "#30027"
msgid "Choose which ROM mapper the core should apply. 'Auto' will work for a wide range of content, but in some cases automatic detection fails."
msgstr ""

msgctxt "#30028"
msgid "Choose which colour palette should be used when an SMS game runs in one of the SG-1000 graphics modes."
msgstr ""

msgctxt "#30029"
msgid "Emulate a Sega CD RAM cart, used for save game data. WARNING: When enabled, internal save data (BRAM) will be discarded."
msgstr ""

msgctxt "#30030"
msgid "Video"
msgstr ""

msgctxt "#30031"
msgid "Configure aspect ratio / LCD filter / video renderer."
msgstr ""

msgctxt "#30032"
msgid "Choose the preferred content aspect ratio. This will only apply when RetroArch's aspect ratio is set to 'Core Provided' in the Video settings."
msgstr ""

msgctxt "#30033"
msgid "4:3"
msgstr ""

msgctxt "#30034"
msgid "Apply an image 'ghosting' filter to mimic the display characteristics of the Game Gear and 'Genesis Nomad' LCD panels."
msgstr ""

msgctxt "#30035"
msgid "disabled"
msgstr ""

msgctxt "#30036"
msgid "Weak"
msgstr ""

msgctxt "#30037"
msgid "Normal"
msgstr ""

msgctxt "#30038"
msgid "Specify video rendering method. 'Accurate' is slowest, but most exact. 'Good' is faster, but fails if colors change mid-frame too often. 'Fast' renders the complete frame in one pass, and is incompatible with games that rely on mid-frame palette/sprite table updates."
msgstr ""

msgctxt "#30039"
msgid "Accurate"
msgstr ""

msgctxt "#30040"
msgid "Good"
msgstr ""

msgctxt "#30041"
msgid "Fast"
msgstr ""

msgctxt "#30042"
msgid "Audio"
msgstr ""

msgctxt "#30043"
msgid "Configure sample rate / emulated audio devices / low pass filter / FM chip type."
msgstr ""

msgctxt "#30044"
msgid "Higher values increase sound quality. Lower values may increase performance. Native is the Mega Drive sound chip rate (~53000). Select this if you want the most accurate audio."
msgstr ""

msgctxt "#30045"
msgid "Enable filtering for Mega Drive FM sound at non-native bitrates. Sound output will improve, at the price of being noticeably slower"
msgstr ""

msgctxt "#30046"
msgid "enabled"
msgstr ""

msgctxt "#30047"
msgid "Enable emulation of the SMS FM Sound Unit. This produces higher quality audio in some games, but non-Japanese titles may fail to run."
msgstr ""

msgctxt "#30048"
msgid "Select the Mega Drive/Genesis FM chip type. Model 1 Mega Drive/Genesis mostly used YM2612, which produced a distinct distortion. YM3438 was used in model 2 consoles."
msgstr ""

msgctxt "#30049"
msgid "YM2612"
msgstr ""

msgctxt "#30050"
msgid "YM3438"
msgstr ""

msgctxt "#30051"
msgid "Enable a low pass audio filter to better simulate the characteristic sound of a Model 1 Mega Drive/Genesis. Note that only Model 1 and its add-ons (Sega CD, 32X) employed a physical low pass filter."
msgstr ""

msgctxt "#30052"
msgid "Low-Pass"
msgstr ""

msgctxt "#30053"
msgid "Specify the cut-off frequency of the low pass audio filter. A higher value increases the perceived 'strength' of the filter, since a wider range of the high frequency spectrum is attenuated."
msgstr ""

msgctxt "#30054"
msgid "Input"
msgstr ""

msgctxt "#30055"
msgid "Configure input devices."
msgstr ""

msgctxt "#30056"
msgid "Choose which type of controller is plugged into slot 1. Note that a multiplayer adaptor uses both slots."
msgstr ""

msgctxt "#30057"
msgid "3 Button Pad"
msgstr ""

msgctxt "#30058"
msgid "6 Button Pad"
msgstr ""

msgctxt "#30059"
msgid "Sega 4 Player Adaptor"
msgstr ""

msgctxt "#30060"
msgid "EA 4way Play Adaptor"
msgstr ""

msgctxt "#30061"
msgid "Choose which type of controller is plugged into slot 2. This setting is ignored when a multiplayer adaptor is plugged into slot 1."
msgstr ""

msgctxt "#30062"
msgid "Performance"
msgstr ""

msgctxt "#30063"
msgid "Configure dynamic recompiler / frameskipping."
msgstr ""

msgctxt "#30064"
msgid "Enable dynamic recompilers which help to improve performance. Less accurate than interpreter CPU cores, but significantly faster."
msgstr ""

msgctxt "#30065"
msgid "Skip frames to avoid audio buffer under-run (crackling). Improves performance at the expense of visual smoothness. 'Auto' skips frames when advised by the frontend. 'Manual' utilises the 'Frameskip Threshold (%)' setting."
msgstr ""

msgctxt "#30066"
msgid "Auto"
msgstr ""

msgctxt "#30067"
msgid "Manual"
msgstr ""

msgctxt "#30068"
msgid "When 'Frameskip' is set to 'Manual', specifies the audio buffer occupancy threshold (percentage) below which frames will be skipped. Higher values reduce the risk of crackling by causing frames to be dropped more frequently."
msgstr ""

msgctxt "#30069"
msgid "Emulation Hacks"
msgstr ""

msgctxt "#30070"
msgid "Configure sprite limit removal / processor overclocking."
msgstr ""

msgctxt "#30071"
msgid "Removes the original sprite-per-scanline hardware limit. This reduces flickering but can cause visual glitches, as some games exploit the hardware limit to generate special effects."
msgstr ""

msgctxt "#30072"
msgid "Overclock the emulated 68K chip. Can reduce slowdown, but may cause glitches."
msgstr ""

